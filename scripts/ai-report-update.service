[Unit]
Description=ai-report — pull latest code and sync deps
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=connormacdonald
WorkingDirectory=/home/connormacdonald/ai-report
ExecStart=/bin/bash -c 'git pull --ff-only origin main && /home/connormacdonald/.local/bin/uv sync --frozen'
