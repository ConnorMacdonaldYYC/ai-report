# AI Report Configuration
# Copy this file to .env and fill in your values.

# ── Provider Selection ──────────────────────────────────────────────────────
# Choose which provider to use: "openai" or "anthropic"
AI_REPORT_MODEL_PROVIDER=openai

# ── API Keys ────────────────────────────────────────────────────────────────
# Required for openai provider:
OPENAI_API_KEY=your-api-key-here

# Required for anthropic provider:
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Base URL (shared across providers) ──────────────────────────────────────
# The opencode.ai proxy works for both OpenAI and Anthropic APIs.
# Override only if you're using a different endpoint.
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# ── Model configuration (defaults shown) ────────────────────────────────────
# When using openai provider, these are OpenAI-compatible model names:
# AI_REPORT_REPORT_MANAGER_MODEL=deepseek-v4-flash
# AI_REPORT_SUB_AGENT_MODEL=deepseek-v4-flash
# AI_REPORT_EVALUATOR_MODEL=deepseek-v4-flash
#
# When using anthropic provider, use Anthropic model names:
# AI_REPORT_REPORT_MANAGER_MODEL=claude-sonnet-4-6
# AI_REPORT_SUB_AGENT_MODEL=claude-sonnet-4-6
# AI_REPORT_EVALUATOR_MODEL=claude-sonnet-4-6

# ── Output ──────────────────────────────────────────────────────────────────
# AI_REPORT_OUTPUT_DIR=./output

# ── Observability ────────────────────────────────────────────────────────────
# AI_REPORT_LOG_ENVIRONMENT=dev

# ── Quality control (defaults shown) ─────────────────────────────────────────
# AI_REPORT_EVAL_THRESHOLD=0.7
# AI_REPORT_MAX_REVISION_CYCLES=1
# AI_REPORT_MAX_TOOL_CALLS=5
# AI_REPORT_MAX_OUTPUT_TOKENS=50000
#
# ── Email Settings ────────────────────────────────────────────────────────────
# AI_REPORT_EMAIL_ENABLED=true
# Comma-separated via JSON array — one or more recipients:
# AI_REPORT_EMAIL_TO=["you@gmail.com"]
# AI_REPORT_EMAIL_TO=["you@gmail.com", "teammate@gmail.com"]
# AI_REPORT_EMAIL_FROM=you@gmail.com
# AI_REPORT_SMTP_USERNAME=you@gmail.com
# AI_REPORT_SMTP_PASSWORD=<gmail app password>
